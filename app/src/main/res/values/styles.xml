<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ডট-নামের স্টাইলগুলোর implicit parent চেইন ভাঙার জন্য বেস স্টাইল -->
    <style name="FindLink" parent="" />
    <style name="Widget.FindLink" parent="" />

    <!-- ===================== Typography ===================== -->
    <style name="FindLink.Text" />
    <style name="FindLink.Text.ScreenTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FindLink.Text.SectionTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FindLink.Text.SectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="FindLink.Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="FindLink.Text.BodyStrong">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="FindLink.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorTextMuted</item>
    </style>

    <!-- ===================== Buttons ===================== -->
    <style name="Widget.FindLink.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.FindLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.FindLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FindLink.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/colorTextPrimary</item>
        <item name="iconSize">22dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===================== Cards ===================== -->
    <style name="Widget.FindLink.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <style name="Widget.FindLink.Card.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <!-- ===================== Inputs ===================== -->
    <style name="Widget.FindLink.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/colorAccent</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="hintTextColor">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextMuted</item>
    </style>

</resources>


