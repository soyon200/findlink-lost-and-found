<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FindLink.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary_soft">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Office"
                android:src="@drawable/ic_location"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfficeName"
                style="@style/FindLink.Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campus Security Office" />

            <TextView
                android:id="@+id/tvOfficeAddress"
                style="@style/FindLink.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Main gate, ground floor" />

            <TextView
                android:id="@+id/tvOfficeHours"
                style="@style/FindLink.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Open 24/7"
                android:textColor="@color/colorAccent" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivOfficeCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Selected"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
